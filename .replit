run = "uvicorn backend.main:app --host 0.0.0.0 --port 8000"
entrypoint = "backend/main.py"
modules = ["python-3.11", "nodejs-20"]

[deployment]
run = ["sh", "-c", "cd frontend && npm install && npm run build && cd .. && uvicorn backend.main:app --host 0.0.0.0 --port 8000"]

[[ports]]
localPort = 8000
externalPort = 80
