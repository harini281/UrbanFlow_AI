# ============================================================
# UrbanFlow AI - Environment Variables
# ============================================================

# Frontend Configuration
# ----------------------
# For unified deployment (FastAPI serving static frontend), leave as /api or empty.
# For decoupled deployment (e.g. Vercel/Netlify frontend pointing to Render backend):
# VITE_API_URL=https://your-urbanflow-backend.onrender.com/api
VITE_API_URL=/api

# Backend Configuration
# ---------------------
# Allowed origins for CORS. Set to * for public access, or comma-separated origins:
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.netlify.app
CORS_ORIGINS=*

# Server Port (automatically provided by Render, Railway, Heroku, etc.)
PORT=8000
